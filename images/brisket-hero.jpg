<svg viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="brisketGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B4513;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#A0522D;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#CD853F;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#brisketGradient)"/>
  <circle cx="400" cy="300" r="150" fill="#6B3410" opacity="0.3"/>
  <text x="400" y="280" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">Brisket Hero Image</text>
  <text x="400" y="310" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle">(Replace with actual BBQ photo)</text>
</svg>
