<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="smokeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2a1a10;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4a2a1a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#smokeGradient)"/>
  <circle cx="200" cy="200" r="120" fill="#6B4423" opacity="0.4"/>
  <text x="200" y="180" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle">Smoked Brisket</text>
  <text x="200" y="210" font-family="Arial, sans-serif" font-size="12" fill="white" text-anchor="middle">(Replace with actual photo)</text>
</svg>
